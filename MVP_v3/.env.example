# MVP_v3의 유일한 환경설정 예제다.
# 로컬 실행: 이 파일을 .env로 복사하고 Secret 값만 교체한다.
# AWS 배포: .env를 올리지 말고 Secrets Manager 또는 배포 환경변수로 주입한다.

# AI provider
OPENAI_API_KEY=replace_with_real_openai_api_key
OPENAI_EVENT_MODEL=gpt-4o-mini
OPENAI_CONTEXT_MODEL=gpt-4o-mini
OPENAI_CASE_BRIEF_MODEL=gpt-4o-mini
OPENAI_CASE_COPILOT_MODEL=gpt-4o-mini
OPENAI_CASE_WORK_CARD_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=20
OPENAI_EVENT_MAX_OUTPUT_TOKENS=350
OPENAI_CONTEXT_MAX_OUTPUT_TOKENS=500
OPENAI_CASE_COPILOT_MAX_OUTPUT_TOKENS=400
OPENAI_CUSTOMER_AI_MAX_OUTPUT_TOKENS=250
OPENAI_CASE_WORK_CARD_MAX_OUTPUT_TOKENS=700
OPENAI_MAX_CALLS_PER_DIAGNOSIS=31
OPENAI_MAX_TOTAL_TOKENS_PER_DIAGNOSIS=16000

# AI analysis limits
DIAGNOSIS_MAX_INPUT_CHARS=6000
DIAGNOSIS_MAX_TURNS=30
WINDOW_TURNS=10
# 기본 배포 모델을 교체할 때만 절대 경로로 활성화한다.
# WINDOW_MODEL_PATH=/absolute/path/to/model.pkl
CASE_COPILOT_MAX_INPUT_CHARS=6000
CUSTOMER_AI_MAX_CONCURRENCY=2
CUSTOMER_AI_MAX_CALLS_PER_MINUTE=6
CUSTOMER_AI_MAX_CALLS_PER_DAY=40

# General API -> AI API. Docker Compose에서는 내부 주소로 자동 덮어쓴다.
AI_API_BASE_URL=http://127.0.0.1:8101
AI_API_TIMEOUT_SECONDS=120
PROACTIVE_QUESTION_AUTOMATION=1
PROACTIVE_CASE_POLL_SECONDS=3

# MySQL. MYSQL_HOST/PORT는 FastAPI를 컨테이너 없이 직접 실행할 때 사용한다.
CASE_REPOSITORY=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Docker Compose 내부에서 General API가 접속할 주소다. 내장 MySQL은 mysql,
# 외부 RDS는 RDS endpoint로 바꾼다.
DEPLOY_MYSQL_HOST=mysql
DEPLOY_MYSQL_PORT=3306
MYSQL_DATABASE=csr
MYSQL_USER=ham
MYSQL_PASSWORD=replace_with_a_long_random_secret
# Docker Compose가 MySQL 컨테이너를 만들 때만 필요하다.
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_secret
MYSQL_CONNECT_TIMEOUT_SECONDS=10

# General API runtime
ATTACHMENT_STORAGE_ROOT=data/uploads
MAX_ATTACHMENT_BYTES=10485760
CASE_ADMIN_DELETE_PASSWORD=replace_with_a_long_random_admin_secret
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5176,http://localhost:5176

# Docker Compose가 외부에 공개할 Frontend 포트
APP_PORT=80
