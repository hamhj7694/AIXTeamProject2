# Safe examples only. The user creates real environment files.
APP_ENV=production
GENERAL_API_HOST=127.0.0.1
GENERAL_API_PORT=8100
AI_API_HOST=127.0.0.1
AI_API_PORT=8101
AI_API_BASE_URL=http://127.0.0.1:8101
# Development Vite proxy only; never embedded in the browser bundle.
GENERAL_API_BASE_URL=http://127.0.0.1:8100
# Local browser smoke harness only. Vite adds these only when both are explicitly set;
# General API accepts them only when APP_ENV=test. Production Nginx never forwards them.
CSR_V4_TEST_PROXY_ACTOR_ID=
CSR_V4_TEST_PROXY_ACTOR_ROLE=
AI_TIMEOUT_SECONDS=5
# [USER_SECRET_REQUIRED] DATABASE_URL. Database name must start with csr_v4.
DATABASE_URL=
ATTACHMENT_STORAGE_ROOT=backend/data/uploads
VECTOR_STORE_PATH=backend/data/vector_db
# Reserved for P2/P5. No paid provider is called by the Phase 0 scaffold.
# [USER_SECRET_REQUIRED] OPENAI_API_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
MAX_API_CALLS=4
MAX_INPUT_TOKENS=6000
MAX_OUTPUT_TOKENS=800
MAX_RETRIES=0
MAX_CONCURRENCY=2
MAX_COST=0.10
